# Caddy automatically obtains and renews a Let's Encrypt certificate for this
# domain, and redirects all HTTP (port 80) traffic to HTTPS (port 443).
openoj.dongziyu.com {
	reverse_proxy web:8080
}

# Optional direct-API endpoint (see docs/API.md). Compose mounts an extra
# site block here only when OPENOJ_CADDY_EXTRA is set — e.g.
#   OPENOJ_CADDY_EXTRA=./deploy/api.caddy docker compose up -d
# Without it this imports nothing and the API is reachable only through the
# web UI's same-origin /api/ route.
import /etc/caddy/extra/*.caddy
